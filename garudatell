        fi

        LATEST_ZIP="$PROJECT_DIR/storage/backups/latest_backup.zip"
        if [ -f "$LATEST_ZIP" ]; then
            SIZE_LATEST=$(du -h "$LATEST_ZIP" 2>/dev/null | cut -f1)
            BACKUP_INFO="${GREEN}Tersedia ($SIZE_LATEST)${NC}"
        else
            BACKUP_INFO="${YELLOW}Belum ada backup lokal${NC}"
