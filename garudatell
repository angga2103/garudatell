# 9. Cek Pembaruan (Update Repository)
menu_check_update() {
    echo -e "${CYAN}${BOLD}[9] CEK PEMBARUAN SISTEM (GIT REPOSITORY UPDATE)${NC}"
    echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    cd "$PROJECT_DIR"

    if [ ! -d ".git" ]; then
        echo -e "${RED}[!] Direktori ini bukan repositori Git resmi.${NC}"
        pause
        return
    fi

    # Tentukan branch aktif
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    echo -e "${BLUE}[*] Memeriksa pembaruan terbaru dari GitHub (origin/$CURRENT_BRANCH)...${NC}"
    git fetch origin "$CURRENT_BRANCH" >/dev/null 2>&1 || git fetch origin >/dev/null 2>&1

    LOCAL_HASH=$(git rev-parse HEAD)
    REMOTE_HASH=$(git rev-parse FETCH_HEAD 2>/dev/null || git rev-parse "origin/$CURRENT_BRANCH" 2>/dev/null || git rev-parse origin/main)

    if [ "$LOCAL_HASH" = "$REMOTE_HASH" ]; then
        echo -e "${GREEN}[✔] GarudaTel Anda sudah menggunakan versi TERBARU (Up-to-Date)!${NC}"
        echo -e "    Commit saat ini: ${YELLOW}${LOCAL_HASH:0:8}${NC} pada branch ${CYAN}$CURRENT_BRANCH${NC}."
    else
        echo -e "${YELLOW}${BOLD}📢 PEMBARUAN TERSEDIA DARI GITHUB!${NC}"
        echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo -e "Daftar pembaruan fitur / patch perbaikan terbaru:"
        git log HEAD..FETCH_HEAD --oneline --decorate -n 5 2>/dev/null || git log HEAD.."origin/$CURRENT_BRANCH" --oneline -n 5
        echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"

        read -p ">> Ada pembaruan tersedia. Update sekarang? (Y/N): " do_update
        if [[ "$do_update" =~ ^[Yy]$ ]]; then
            echo ""
            echo -e "${BLUE}[1/5] Mengambil pembaruan source code (git fetch & sync)...${NC}"
            # Bersihkan modifikasi lokal/line endings agar tidak menabrak merge conflict
            git stash 2>/dev/null || true
            git fetch origin "$CURRENT_BRANCH" 2>/dev/null || git fetch origin main 2>/dev/null || true
            git reset --hard "origin/$CURRENT_BRANCH" 2>/dev/null || git reset --hard origin/main 2>/dev/null || git pull origin main

            echo -e "${BLUE}[2/5] Memeriksa & mengupgrade dependensi paket (requirements.txt)...${NC}"
            $PROJECT_DIR/venv/bin/pip install -r requirements.txt --upgrade --quiet 2>/dev/null || true

            echo -e "${BLUE}[3/5] Menjalankan verifikasi database seeder & migrasi tabel/kolom baru...${NC}"
            $VENV_PYTHON "$PROJECT_DIR/tools/init_app.py" >/dev/null 2>&1 || true
            $VENV_PYTHON "$PROJECT_DIR/tools/migrate_tier_and_downline.py" >/dev/null 2>&1 || true
            $VENV_PYTHON "$PROJECT_DIR/tools/migrate_quick.py" >/dev/null 2>&1 || true

            echo -e "${BLUE}[4/5] Merestart layanan GarudaTel & Bot Admin...${NC}"
            sudo systemctl restart garudatel 2>/dev/null || true
            sudo systemctl restart garudatel-bot-admin 2>/dev/null || true

            if [ -d "$PROJECT_DIR/wa_bot" ]; then
                echo -e "${BLUE}[5/5] Memeriksa dependensi & merestart mesin WhatsApp Bot (PM2)...${NC}"
                cd "$PROJECT_DIR/wa_bot"
                npm install --omit=dev --quiet 2>/dev/null || true
                pm2 restart garudatel-wa-bot 2>/dev/null || pm2 start server_bot.js --name garudatel-wa-bot --restart-delay=3000 2>/dev/null || true
                cd "$PROJECT_DIR"
            fi

            UPDATED_HASH=$(git rev-parse HEAD 2>/dev/null)
            echo ""
            echo -e "${GREEN}${BOLD}🎉 PEMBARUAN SUKSES DIAPLIKASIKAN SECARA LENGKAP! 🚀${NC}"
            echo -e "Commit sekarang: ${YELLOW}${UPDATED_HASH:0:8}${NC}"
            echo -e "Seluruh service (Web, Bot Admin Telegram, Bot WhatsApp PM2) telah berjalan dengan versi terbaru."
        else
            echo -e "${YELLOW}[!] Pembaruan ditunda oleh pengguna.${NC}"
        fi
    fi
    pause
}

