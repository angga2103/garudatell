# 7. Manajemen Cloudflare Zero Trust
menu_cloudflare() {
    while true; do
        clear
        echo -e "${CYAN}${BOLD}"
        echo "  ╔══════════════════════════════════════════════════════════════╗"
        echo "  ║             ☁️ MANAJEMEN CLOUDFLARE ZERO TRUST ☁️             ║"
        echo "  ╚══════════════════════════════════════════════════════════════╝"
        echo -e "${NC}"
        
        if systemctl is-active --quiet cloudflared 2>/dev/null; then
            echo -e "  Status Daemon : ${GREEN}● AKTIF & BERJALAN (cloudflared)${NC}"
        else
            echo -e "  Status Daemon : ${RED}● NONAKTIF / TIDAK DITEMUKAN${NC}"
        fi
        echo -e "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo -e "  ${BOLD}[1]${NC} Tampilkan Status Detail Tunnel (systemctl status cloudflared)"
        echo -e "  ${BOLD}[2]${NC} Ganti / Edit Token Cloudflare Zero Trust (Update Tunnel Domain)"
        echo -e "  ${BOLD}[3]${NC} Restart Service Cloudflared"
        echo -e "  ${BOLD}[0]${NC} Kembali ke Menu Utama"
        echo -e "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        read -p ">> Masukkan pilihan [0-3]: " cf_choice

        case $cf_choice in
            1)
                echo ""
                echo -e "${CYAN}${BOLD}Status Layanan Cloudflared:${NC}"
                sudo systemctl status cloudflared --no-pager || true
                pause
                ;;
            2)
                echo ""
                echo -e "${YELLOW}${BOLD}GANTI / UPDATE TOKEN CLOUDFLARE ZERO TRUST${NC}"
                echo -e "Fitur ini sangat berguna jika domain Anda tersuspend, berganti domain,"
                echo -e "atau Anda membuat tunnel baru di Cloudflare Zero Trust Dashboard.\n"
                echo -e "Dapatkan token di: ${CYAN}Zero Trust -> Networks -> Tunnels -> Connector Token${NC}"
                echo -e "(String panjang diawali ${PURPLE}eyJhIjoiMTgyYT...${NC})\n"
                
                read -p ">> Masukkan Token Cloudflare Baru: " NEW_CF_TOKEN
                NEW_CF_TOKEN=$(echo "$NEW_CF_TOKEN" | tr -d '\r\n ' | sed -e "s/'//g" -e 's/"//g')

                if [ -z "$NEW_CF_TOKEN" ]; then
                    echo -e "${RED}[!] Token kosong. Dibatalkan.${NC}"
                else
                    echo -e "${BLUE}[*] Memasang ulang connector tunnel dengan token baru...${NC}"
                    if command -v cloudflared &> /dev/null; then
                        sudo cloudflared service uninstall || true
                        sudo cloudflared service install "$NEW_CF_TOKEN"
                        sudo systemctl daemon-reload
                        sudo systemctl enable cloudflared
                        sudo systemctl restart cloudflared
                        sleep 2
                        if systemctl is-active --quiet cloudflared; then
                            echo -e "${GREEN}[✔] Token Cloudflare berhasil diperbarui dan tunnel telah aktif!${NC}"
                        else
                            echo -e "${YELLOW}[!] Tunnel terpasang, periksa status: sudo systemctl status cloudflared${NC}"
                        fi
                    else
                        echo -e "${RED}[✖] cloudflared belum terinstal. Jalankan install.sh terlebih dahulu.${NC}"
                    fi
                fi
                pause
                ;;
            3)
                echo ""
                echo -e "${BLUE}[*] Merestart cloudflared service...${NC}"
                sudo systemctl restart cloudflared
                sleep 1
                echo -e "${GREEN}[✔] Service cloudflared telah direstart.${NC}"
                pause
                ;;
            0)
                break
                ;;
            *)
                echo -e "${RED}Pilihan tidak valid!${NC}"
                sleep 1
                ;;
        esac
    done
}

