# =====================================================================
# GARUDATEL V2 - SYSTEMD SERVICE FILE
# =====================================================================
# File: garudatel.service
# Deskripsi: Service untuk auto-start dan auto-restart Gunicorn
# Install: sudo cp garudatel.service /etc/systemd/system/
# Enable: sudo systemctl enable garudatel
# Start: sudo systemctl start garudatel
# Status: sudo systemctl status garudatel
# =====================================================================

[Unit]
Description=Garudatel V2 PPOB Platform (Gunicorn)
After=network.target

[Service]
Type=notify
# Keamanan: Gunakan unprivileged user (www-data) demi prinsip Least Privilege
User=www-data
Group=www-data
WorkingDirectory=/var/www/garudatel
Environment="PATH=/var/www/garudatel/venv/bin"
ExecStart=/var/www/garudatel/venv/bin/gunicorn \
    --workers 4 \
    --bind 127.0.0.1:5000 \
    --timeout 120 \
    --log-level info \
    --access-logfile /var/www/garudatel/storage/logs/access.log \
    --error-logfile /var/www/garudatel/storage/logs/error.log \
    wsgi:app

# Restart policy
Restart=always
RestartSec=10

# Security
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
