# ==============================================================================
# GARUDATEL v2 - ENVIRONMENT TEMPLATE CONFIGURATION
# ==============================================================================
# Salin file ini menjadi .env pada saat deployment:
# cp .env.example .env
#
# Seluruh nilai di bawah dapat dikonfigurasi melalui:
# 1. Mengedit langsung file .env ini, ATAU
# 2. Masuk ke Panel Web Admin -> Pengaturan / Konfigurasi
# ==============================================================================

# 1. KEAMANAN FLASK
# Generate string acak 32/64 karakter hex untuk proteksi session & CSRF
SECRET_KEY=generate_random_secret_key_here

# 2. PAYMENT GATEWAY AKTIF
# Pilihan: 'pakasir' atau 'paymentkita'
ACTIVE_PAYMENT_GATEWAY=pakasir

# 3. KREDENSIAL PROVIDER DIGIFLAZZ (PULSA, PAKET DATA, PLN, E-MONEY)
# Diperoleh dari dashboard https://member.digiflazz.com
DIGI_USER=
DIGI_KEY=
DIGI_URL=https://api.digiflazz.com/v1

# 4. KREDENSIAL PAYMENT GATEWAY PAKASIR (QRIS OTOMATIS)
# Diperoleh dari dashboard https://app.pakasir.com
PAKASIR_PROJECT=
PAKASIR_API_KEY=

# 5. KREDENSIAL PAYMENT GATEWAY PAYMENTKITA (OPSI CADANGAN)
# Diperoleh dari dashboard https://paymentkita.id
PAYMENTKITA_MERCHANT_ID=
PAYMENTKITA_SECRET=

# 6. KREDENSIAL PROVIDER VIP-RESELLER (TOP UP GAMES & VOUCHER)
# Diperoleh dari dashboard https://vip-reseller.co.id
VIP_API_ID=
VIP_API_KEY=

# 7. TELEGRAM BOT 1 : CS & BALAS INBOX
# Menerima tiket bantuan dari pengguna dan meneruskan pesan keluhan
BOT_CS_TOKEN=
BOT_CS_CHAT_ID=

# 8. TELEGRAM BOT 2 : NOTIFIKASI TRANSAKSI & LAPORAN BACKUP
# Menerima alert otomatis setiap ada transaksi baru/sukses/gagal & snapshot backup DB
BOT_NOTIF_TOKEN=
BOT_NOTIF_CHAT_ID=

# 9. TELEGRAM BOT 3 : PANEL KONTROL ADMIN (INLINE BUTTON)
# Panel interaktif tombol untuk cek saldo, omset, trx pending, sync, dan OTP darurat
BOT_ADMIN_TOKEN=
BOT_ADMIN_CHAT_ID=

