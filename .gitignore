venv/
env/
ENV/
.env.local

# Database (Production database should not be tracked by git)
*.db
*.db-shm
*.db-wal
*.db.gz
*.sqlite
*.sqlite3
app/garudatel.db

# Storage and runtime files
storage/temp/*
storage/logs/*
storage/cache/*
storage/backups/*
!storage/temp/.gitkeep
!storage/logs/.gitkeep
!storage/cache/.gitkeep
!storage/backups/.gitkeep

# Sensitive environment files
.env
.env.*
!.env.example
*.pem
*.key

# Archive directory (legacy scripts & backups)
archive/

# Editor & OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

